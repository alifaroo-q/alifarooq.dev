# Resend, for the contact form. The key is created against the
# send.alifarooq.dev sending domain.
RESEND_API_KEY=

# The inbox is the system of record, so every message is also copied to a
# second mailbox on a DIFFERENT provider. That is the whole point of the
# address — do not point it at another alias of the primary inbox.
CONTACT_BCC_EMAIL=

# Umami Cloud Hobby, EU region.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
